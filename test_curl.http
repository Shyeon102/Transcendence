###
# Get a token first
curl -k -X POST https://localhost:8443/api/auth/token/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "password": "ValidPass1!"
  }'
###
# Should fail - new password too short
curl -k -X POST https://localhost:8443/api/auth/changePassword/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "old_password": "ValidPass1!",
    "new_password": "short"
  }'
###
# Should fail - no uppercase
curl -k -X POST https://localhost:8443/api/auth/changePassword/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "old_password": "ValidPass1!",
    "new_password": "nouppercase1!"
  }'
###
# Should fail - wrong old password
curl -k -X POST https://localhost:8443/api/auth/changePassword/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "old_password": "wrongpassword",
    "new_password": "NewValid1!"
  }'
###
# Should succeed
curl -k -X POST https://localhost:8443/api/auth/changePassword/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "old_password": "ValidPass1!",
    "new_password": "NewValid1!"
  }'
