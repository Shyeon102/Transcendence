  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "old_password": "wrongpassword",
    "new_password": "NewValid1!"
  }'
###
# Should succeed
curl -k -X POST https://localhost/api/auth/changePassword/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
