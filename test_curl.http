  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "testuser@example.com",
    "password": "testpassword123"
  }'

###

# Should fail - password too short
curl -k -X POST https://localhost:8443/api/auth/register/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "test@example.com",
    "password": "short"
  }'
###
# Should fail - no uppercase
curl -k -X POST https://localhost:8443/api/auth/register/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "test@example.com",
    "password": "nouppercase1!"
  }'
###
# Should fail - no number
curl -k -X POST https://localhost:8443/api/auth/register/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "test@example.com",
    "password": "NoNumber!"
  }'

### 
# Should fail - no special character
curl -k -X POST https://localhost:8443/api/auth/register/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "test@example.com",
    "password": "NoSpecial1"
  }'

### 
# Should succeed
curl -k -X POST https://localhost:8443/api/auth/register/ \
  -H "Content-Type: application/json" \
  -d '{
    "username": "testuser",
    "email": "test@example.com",
    "password": "ValidPass1!"
  }'
###
curl -X POST https://localhost:8443/api/community/posts/ \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer {{token}}" \
  -d '{
    "title": "My first post",
    "content": "Hello world from curl",
    "media_files": []
  }'

###

