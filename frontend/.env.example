# Use /api when a reverse proxy forwards frontend requests to Django.
VITE_API_BASE_URL=http://localhost:8000/api

# Alternative when nginx/Docker proxies /api to Django:
# VITE_API_BASE_URL=/api

# Google Identity Services client id.
VITE_GOOGLE_CLIENT_ID=

# Backend endpoint that accepts the Google credential and returns app tokens.
VITE_GOOGLE_AUTH_ENDPOINT=/auth/google/
